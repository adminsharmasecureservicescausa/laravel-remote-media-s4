#!/usr/bin/env bash
# ==============================================================================
# mTLS Client Certificate Generator Template
# Generates a Certificate Authority (CA) and a password-protected PKCS#12 (.p12)
# client certificate for browser authentication.
# ==============================================================================

set -euo pipefail

CERT_DIR="/etc/nginx/client-certs"
CLIENT_EMAIL="REPLACE__ME_ADMIN_EMAIL@example.com"
CLIENT_NAME="REPLACE__ME_ADMIN_NAME"
P12_PASSWORD="REPLACE__ME_P12_PASSWORD"

echo "Creating certificate directory at ${CERT_DIR}..."
mkdir -p "${CERT_DIR}"
cd "${CERT_DIR}"

echo "1. Generating Certificate Authority (CA)..."
openssl req -x509 -newkey rsa:4096 -days 3650 -nodes \
  -keyout ca.key -out ca.crt \
  -subj "/C=US/ST=State/L=City/O=SecureStream-CA/CN=SecureStream-Root-CA"

echo "2. Generating Client Certificate Request..."
openssl req -newkey rsa:2048 -nodes \
  -keyout client.key -out client.csr \
  -subj "/C=US/ST=State/L=City/O=SecureStream/CN=${CLIENT_NAME}/emailAddress=${CLIENT_EMAIL}"

echo "3. Signing Client Certificate with CA..."
openssl x509 -req -in client.csr -CA ca.crt -CAkey ca.key -CAcreateserial \
  -out client.crt -days 3650 -sha256

echo "4. Exporting Client PKCS#12 bundle (.p12 for browser / OS keychain import)..."
openssl pkcs12 -export -out client.p12 -inkey client.key -in client.crt -certfile ca.crt -passout pass:"${P12_PASSWORD}"

echo "5. Restricting file permissions..."
chmod 600 ca.key client.key client.p12
chmod 644 ca.crt client.crt

echo "Done! Certificate files created in ${CERT_DIR}."
echo "Import 'client.p12' into your browser with password: ${P12_PASSWORD}"
