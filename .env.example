APP_NAME="SecureStream"
APP_ENV=production
APP_KEY=REPLACE__ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://REPLACE__ME_DOMAIN.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (SQLite or MySQL)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=REPLACE__ME_DB_NAME
# DB_USERNAME=REPLACE__ME_DB_USER
# DB_PASSWORD=REPLACE__ME_DB_PASSWORD

# Session Security Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# S3 / MEGA S4 Storage Credentials (Strict Private Bucket with Pre-Signed V4 URLs)
AWS_ACCESS_KEY_ID=REPLACE__ME_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE__ME_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ca-vancouver-1
AWS_BUCKET=REPLACE__ME_BUCKET_NAME
AWS_ENDPOINT=https://s3.ca-vancouver-1.megas4.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Media Streaming & Rate Limiting Security
MEDIA_STREAM_TTL_MINUTES=15
MEDIA_RATE_LIMIT_PER_MINUTE=60

VITE_APP_NAME="${APP_NAME}"
