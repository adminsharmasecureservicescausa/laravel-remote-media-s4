APP_NAME="SecureStream"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://stream.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (SQLite or MySQL)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=secure_media_db
# DB_USERNAME=secure_user
# DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# AWS S3 Private Storage Configuration (Strict Zero Public Access)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=my-private-secure-media-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=https://my-private-secure-media-bucket.s3.us-east-1.amazonaws.com

# Media Streaming Security Settings
MEDIA_STREAM_TTL_MINUTES=15
MEDIA_RATE_LIMIT_PER_MINUTE=60

VITE_APP_NAME="${APP_NAME}"
